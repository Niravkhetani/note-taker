{
    "manifest_version": 3,
    "name": "React Chrome Extension",
    "version": "1.0.0",
    "description": "A simple React app as a Chrome extension",
    "icons": {
      "48": "images/icon.png"
    },
    "action": {
      "default_popup": "index.html"
    },
    "content_scripts":[{
      "js": ["assets/content.js"],
      "matches": ["https://*/*"]
    }],
    "background":{
      "service_worker": "assets/background.js",
      "type": "module"
    },
    "web_accessible_resources": [{
      "matches": ["https://*/*"],
      "resources": ["assets/*"]
   }],
    "permissions": []
  }